<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="440dp"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/settings_title"
        android:textColor="@color/text"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/row_file"
        style="@style/SettingsRow"
        android:text="@string/row_wallpaper_file" />

    <TextView
        android:id="@+id/row_picsum"
        style="@style/SettingsRow"
        android:text="@string/row_wallpaper_picsum" />

    <TextView
        android:id="@+id/row_unsplash"
        style="@style/SettingsRow"
        android:text="@string/row_wallpaper_unsplash" />

    <TextView
        android:id="@+id/row_auto"
        style="@style/SettingsRow" />

    <TextView
        android:id="@+id/row_system"
        style="@style/SettingsRow"
        android:text="@string/row_system_settings" />
</LinearLayout>
