<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:scrollbars="none">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/row_system"
        style="@style/SettingsRow"
        android:layout_marginTop="0dp"
        android:text="@string/row_system_settings"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/row_default_home"
        style="@style/SettingsRow"
        android:text="@string/row_default_home" />

    <TextView
        android:id="@+id/row_per_row"
        style="@style/SettingsRow" />

    <TextView
        android:id="@+id/row_rows"
        style="@style/SettingsRow" />

    <TextView
        android:id="@+id/row_wallhaven"
        style="@style/SettingsRow"
        android:text="@string/src_wallhaven" />

    <TextView
        android:id="@+id/row_wikimedia"
        style="@style/SettingsRow"
        android:text="@string/src_wikimedia" />

    <TextView
        android:id="@+id/row_picsum"
        style="@style/SettingsRow"
        android:text="@string/src_picsum" />

    <TextView
        android:id="@+id/row_bing"
        style="@style/SettingsRow"
        android:text="@string/src_bing" />

    <TextView
        android:id="@+id/row_off"
        style="@style/SettingsRow"
        android:text="@string/row_rotation_off" />

    <TextView
        android:id="@+id/row_bing_daily"
        style="@style/SettingsRow"
        android:text="@string/row_bing_daily" />
</LinearLayout>
</ScrollView>
